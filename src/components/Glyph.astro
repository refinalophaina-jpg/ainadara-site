---
// On-brand card glyphs, drawn in the logo's visual language (round caps, the three
// brand colors). Dark mode recolors them via the [data-theme="dark"] svg rules in Base.astro.
interface Props { name: string; }
const { name } = Astro.props;
const T = "#cc785c", P = "#4a3d7a", M = "#4a5c28", I = "#2d3428";
---
<svg class="project-glyph" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  {name === "spiral" && (
    <g stroke={T} fill="none" stroke-linecap="round">
      <circle cx="32" cy="32" r="22" stroke-width="1.2" />
      <circle cx="32" cy="32" r="16" stroke-width="1.4" />
      <circle cx="32" cy="32" r="10" stroke-width="1.6" />
      <circle cx="32" cy="32" r="4" stroke-width="1.8" />
      <circle cx="32" cy="32" r="1.8" fill={T} stroke="none" />
    </g>
  )}
  {name === "book" && (
    <g stroke={M} fill="none" stroke-linecap="round" stroke-width="1.5">
      <path d="M 16 18 L 16 48 L 32 44 L 48 48 L 48 18 L 32 14 Z" />
      <line x1="32" y1="14" x2="32" y2="44" />
      <line x1="22" y1="24" x2="28" y2="22.5" />
      <line x1="22" y1="30" x2="28" y2="28.5" />
      <line x1="36" y1="22.5" x2="42" y2="24" />
      <line x1="36" y1="28.5" x2="42" y2="30" />
    </g>
  )}
  {name === "rays" && (
    <g stroke={P} stroke-linecap="round" fill="none">
      <line x1="32" y1="32" x2="32" y2="14" stroke-width="1.8" />
      <line x1="32" y1="32" x2="44" y2="20" stroke-width="1.6" />
      <line x1="32" y1="32" x2="50" y2="32" stroke-width="1.6" />
      <line x1="32" y1="32" x2="44" y2="44" stroke-width="1.4" />
      <line x1="32" y1="32" x2="32" y2="50" stroke-width="1.4" />
      <line x1="32" y1="32" x2="20" y2="44" stroke-width="1.2" />
      <line x1="32" y1="32" x2="14" y2="32" stroke-width="1.2" />
      <line x1="32" y1="32" x2="20" y2="20" stroke-width="1.4" />
      <circle cx="32" cy="32" r="2.5" fill={P} stroke="none" />
    </g>
  )}
  {name === "nodes" && (
    <g stroke={P} fill="none" stroke-linecap="round" stroke-width="1.4">
      <line x1="20" y1="20" x2="44" y2="28" />
      <line x1="44" y1="28" x2="24" y2="46" />
      <line x1="20" y1="20" x2="24" y2="46" />
      <circle cx="20" cy="20" r="4" fill={T} stroke="none" />
      <circle cx="44" cy="28" r="4" fill={P} stroke="none" />
      <circle cx="24" cy="46" r="4" fill={M} stroke="none" />
    </g>
  )}
  {name === "waves" && (
    <g fill="none" stroke-linecap="round">
      <path d="M 12 24 Q 32 38 52 24" stroke={I} stroke-width="1.8" />
      <path d="M 14 34 Q 32 46 50 34" stroke={M} stroke-width="1.5" opacity="0.7" />
      <path d="M 16 42 Q 32 52 48 42" stroke={T} stroke-width="1.2" opacity="0.55" />
    </g>
  )}
  {name === "chart" && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="14,44 26,32 36,38 50,18" stroke={T} stroke-width="1.8" />
      <line x1="14" y1="14" x2="14" y2="48" stroke={I} stroke-width="1.4" />
      <line x1="14" y1="48" x2="50" y2="48" stroke={I} stroke-width="1.4" />
      <circle cx="50" cy="18" r="2.4" fill={T} stroke="none" />
    </g>
  )}
  {name === "hearth" && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path d="M 16 30 L 32 16 L 48 30 L 48 48 L 16 48 Z" stroke={I} stroke-width="1.6" />
      <path d="M 28 48 L 28 36 L 36 36 L 36 48" stroke={T} stroke-width="1.4" />
    </g>
  )}
</svg>
